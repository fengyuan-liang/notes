        <mxCell id="k2hgn9Dceoytbyq07EMz-18" value="&lt;b&gt;交易域&lt;/b&gt;&lt;br&gt;负责：下单、订单状态、支付&lt;br&gt;不负责：商品信息透出" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">

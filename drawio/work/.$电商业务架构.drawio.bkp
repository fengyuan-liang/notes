        <mxCell id="k2hgn9Dceoytbyq07EMz-9" value="业务域与职责边界" style="text;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#344054;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="116" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-10" value="&lt;b&gt;商品中心&lt;/b&gt;&lt;br&gt;负责：SPU/SKU 主数据、类目、属性、图文详情&lt;br&gt;不负责：价格、库存、能不能买" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="138" width="240" height="98" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-11" value="&lt;b&gt;价格中心&lt;/b&gt;&lt;br&gt;负责：基础价、活动价、税费、币种换算&lt;br&gt;不负责：谁能看到什么价" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="138" width="240" height="98" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-12" value="&lt;b&gt;库存中心&lt;/b&gt;&lt;br&gt;负责：可售库存、锁定、扣减&lt;br&gt;不负责：“仅剩 3 件”这类话术" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="138" width="240" height="98" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-13" value="&lt;b&gt;营销中心&lt;/b&gt;&lt;br&gt;负责：优惠规则与试算、券&lt;br&gt;不负责：优惠怎么摆到页面上" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="244" width="240" height="98" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-14" value="&lt;b&gt;履约中心&lt;/b&gt;&lt;br&gt;负责：时效、运费、承运、轨迹&lt;br&gt;不负责：商品信息" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="244" width="240" height="98" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-15" value="&lt;b&gt;评价中心&lt;/b&gt;&lt;br&gt;负责：UGC 内容、审核、聚合分&lt;br&gt;不负责：怎么排序、怎么表达心智" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="244" width="240" height="98" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-16" value="&lt;b&gt;搜推引擎&lt;/b&gt;&lt;br&gt;负责：候选与排序&lt;br&gt;不负责：页面呈现" style="rounded=1;fillColor=#ffffff;strokeColor=#bcc9d6;fontColor=#243447;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="350" width="240" height="98" as="geometry" />
        </mxCell>
        <mxCell id="k2hgn9Dceoytbyq07EMz-17" value="&lt;b&gt;详情域&lt;/b&gt;&lt;br&gt;负责：聚合、编排、表达、兜底&lt;br&gt;不负责：自己生产商品/价格/库存数据" style="rounded=1;fillColor=#e8f3ff;strokeColor=#6c9bd2;fontColor=#17365d;fontSize=10;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=7;spacingTop=5;spacingBottom=4;whiteSpace=wrap;html=1;" vertex="1" parent="1">
